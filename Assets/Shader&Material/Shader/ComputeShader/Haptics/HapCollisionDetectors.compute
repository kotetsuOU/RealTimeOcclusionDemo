#pragma kernel CheckCollision
#pragma kernel CheckCollisionMesh
#pragma kernel AccumulateGrasp

// Defined same as STRIDE in RsGlobalPointCloudManager
struct PointData
{
    float3 pos;
    float3 col;
    uint type;
};

// アタリ判定の結果と、命中位置・法線・どの点群点/メッシュ頂点が対応したかを格納する構造体
struct HitResult
{
    int isColliding;
    float3 hitPoint;
    float3 hitNormal;
    int pointIndex; // 接触した点群側のインデックス
    int vertIndex;  // 接触したメッシュ頂点側のインデックス（TransformOnlyモードでは-1）
};

StructuredBuffer<PointData> PointCloudBuffer;
RWStructuredBuffer<HitResult> Result;
RWStructuredBuffer<int> HitCounter; // [0]のみ使用。スロット確保用のアトミックカウンタ

int PointsCount;
int MaxHits; // Result バッファの最大スロット数
float3 TargetPosition;
float Radius;
float RadiusSqr;

// For SkinnedMeshRenderer / MeshFilter mode
StructuredBuffer<float3> MeshVerticesBuffer;
StructuredBuffer<float3> MeshNormalsBuffer;
float4x4 LocalToWorldMatrix;
int MeshVerticesCount;
float3 MeshBoundsMin;
float3 MeshBoundsMax;
int VertexSubstep;

[numthreads(256, 1, 1)]
void CheckCollision(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) PointsCount)
        return;

    float3 pointPos = PointCloudBuffer[id.x].pos;
    float3 diff = pointPos - TargetPosition;

    if (dot(diff, diff) <= RadiusSqr)
    {
        int slot;
        InterlockedAdd(HitCounter[0], 1, slot);
        if (slot < MaxHits)
        {
            Result[slot].isColliding = 1;
            Result[slot].hitPoint = pointPos;
            Result[slot].hitNormal = normalize(diff);
            Result[slot].pointIndex = (int) id.x;
            Result[slot].vertIndex = -1;
        }
    }
}

[numthreads(256, 1, 1)]
void CheckCollisionMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) PointsCount)
        return;

    float3 pointPos = PointCloudBuffer[id.x].pos;

    // 1. Broad-phase AABB Culling
    if (pointPos.x < MeshBoundsMin.x || pointPos.x > MeshBoundsMax.x ||
        pointPos.y < MeshBoundsMin.y || pointPos.y > MeshBoundsMax.y ||
        pointPos.z < MeshBoundsMin.z || pointPos.z > MeshBoundsMax.z)
    {
        return;
    }

    // 2. Narrow-phase Sampling
    for (int i = 0; i < MeshVerticesCount; i += VertexSubstep)
    {
        float3 localVert = MeshVerticesBuffer[i];
        float3 worldVert = mul(LocalToWorldMatrix, float4(localVert, 1.0)).xyz;

        float3 diff = pointPos - worldVert;
        if (dot(diff, diff) <= RadiusSqr)
        {
            // この点群点(id.x)につき1スロットのみ消費する
            int slot;
            InterlockedAdd(HitCounter[0], 1, slot);
            if (slot < MaxHits)
            {
                float3 localNorm = MeshNormalsBuffer[i];
                float3 worldNorm = mul((float3x3) LocalToWorldMatrix, localNorm);
                Result[slot].isColliding = 1;
                Result[slot].hitPoint = worldVert;
                Result[slot].hitNormal = normalize(worldNorm);
                Result[slot].pointIndex = (int) id.x;
                Result[slot].vertIndex = i;
            }
            return;
        }
    }
}

// ---- 握り込み(Grasp)判定用 ----
// GraspStats のレイアウト（HapGraspInteractor 側の定数と一致させること）
//   [0]      : 接触殻(GraspRadius以内)の点数
//   [1..3]   : 同、球中心からのオフセット合計 (mm)
//   [4..6]   : 同、中心→点の単位方向ベクトル合計 (x1000)
//   [7]      : 追従用領域(GraspTrackRadius以内)の点数
//   [8..10]  : 同、球中心からのオフセット合計 (mm)
//   [11+o*4+{0..3}] : オクタント o の (点数, オフセット合計x,y,z (mm))
// 整数アトミック加算で集計するため、座標は球中心基準のmm固定小数にしている
#define GRASP_FIXED_SCALE 1000.0
#define GRASP_OCTANT_BASE 11

RWStructuredBuffer<int> GraspStats;
float3 GraspCenter;
float GraspRadiusSqr;
float GraspTrackRadiusSqr;

[numthreads(256, 1, 1)]
void AccumulateGrasp(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) PointsCount)
        return;

    float3 diff = PointCloudBuffer[id.x].pos - GraspCenter;
    float distSqr = dot(diff, diff);
    if (distSqr > GraspTrackRadiusSqr)
        return;

    int3 q = (int3) round(diff * GRASP_FIXED_SCALE);

    InterlockedAdd(GraspStats[7], 1);
    InterlockedAdd(GraspStats[8], q.x);
    InterlockedAdd(GraspStats[9], q.y);
    InterlockedAdd(GraspStats[10], q.z);

    if (distSqr > GraspRadiusSqr)
        return;

    int3 dir = (int3) round(diff * rsqrt(max(distSqr, 1e-10)) * GRASP_FIXED_SCALE);
    InterlockedAdd(GraspStats[0], 1);
    InterlockedAdd(GraspStats[1], q.x);
    InterlockedAdd(GraspStats[2], q.y);
    InterlockedAdd(GraspStats[3], q.z);
    InterlockedAdd(GraspStats[4], dir.x);
    InterlockedAdd(GraspStats[5], dir.y);
    InterlockedAdd(GraspStats[6], dir.z);

    int octant = (diff.x >= 0 ? 1 : 0) | (diff.y >= 0 ? 2 : 0) | (diff.z >= 0 ? 4 : 0);
    int b = GRASP_OCTANT_BASE + octant * 4;
    InterlockedAdd(GraspStats[b], 1);
    InterlockedAdd(GraspStats[b + 1], q.x);
    InterlockedAdd(GraspStats[b + 2], q.y);
    InterlockedAdd(GraspStats[b + 3], q.z);
}
