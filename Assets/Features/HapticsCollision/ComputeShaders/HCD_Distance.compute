#pragma kernel ClearMeshGrid
#pragma kernel BuildMeshGrid
#pragma kernel CheckCollisionTransform
#pragma kernel CheckCollisionMesh
#pragma kernel CheckCollisionFootPlane

struct PointCollisionData
{
    int isColliding;     // 0: None, 1: Surface, 2: Inside
    float distance;      // メッシュ表面までの距離 (m)
    float3 pointPos;     // 点群実測座標
    float3 hitPoint;     // メッシュ表面の投影点
    float3 hitNormal;    // メッシュ表面法線
};

struct PointCloudPoint
{
    float3 position;  // 12 bytes
    float3 color;     // 12 bytes
    uint   originType; //  4 bytes  (total = 28 bytes, matches RsGlobalPointCloudManager.STRIDE)
};
StructuredBuffer<PointCloudPoint> PointCloudBuffer;
RWStructuredBuffer<PointCollisionData> ResultBuffer;

uint PointsCount;

// TransformOnly
float3 TargetPosition;
StructuredBuffer<float3> TargetPositionsBuffer;
uint TargetPositionsCount;

// Distance Thresholds
float SurfaceDistanceThreshold;
float BackfaceDistanceThreshold;

// View Direction Thresholds (Visible vs Occluded)
float VisibleSurfaceDistanceThreshold;
float VisibleBackfaceDistanceThreshold;
float OccludedSurfaceDistanceThreshold;
float OccludedBackfaceDistanceThreshold;

// Distance Mode Settings
int DistanceMode; // 0: MeshSurface, 1: ViewDirection
float3 CameraPosition;

// Mesh
StructuredBuffer<float3> MeshVerticesBuffer;
StructuredBuffer<float3> MeshNormalsBuffer;
StructuredBuffer<int> MeshIndicesBuffer;
uint MeshTrianglesCount;
float4x4 LocalToWorldMatrix;
float3 MeshBoundsMin;
float3 MeshBoundsMax;

// Voxel Grid for Mesh
RWStructuredBuffer<int> GridBuffer;
float3 GridBoundsMin;
float3 GridCellSize;
int3 GridResolution; // default (8,8,8)

// FootPlane Mode
float4x4 WorldToTargetMatrix;
float3 FootPlaneBoundsMin;
float3 FootPlaneBoundsMax;
float FootPlaneRefY;
float FootPlaneDepthThreshold;
float FootPlaneUpperMargin;
float3 FootPlaneNormal;

#define GRID_CELL_STRIDE 128
#define MAX_TRIS_PER_CELL 127

[numthreads(256, 1, 1)]
void ClearMeshGrid (uint3 id : SV_DispatchThreadID)
{
    uint totalCells = (uint)(GridResolution.x * GridResolution.y * GridResolution.z);
    if (id.x >= totalCells) return;
    GridBuffer[id.x * GRID_CELL_STRIDE] = 0;
}

[numthreads(256, 1, 1)]
void BuildMeshGrid (uint3 id : SV_DispatchThreadID)
{
    uint triIdx = id.x;
    if (triIdx >= MeshTrianglesCount) return;

    int idxA = MeshIndicesBuffer[triIdx*3];
    int idxB = MeshIndicesBuffer[triIdx*3+1];
    int idxC = MeshIndicesBuffer[triIdx*3+2];
    
    float3 localA = MeshVerticesBuffer[idxA];
    float3 localB = MeshVerticesBuffer[idxB];
    float3 localC = MeshVerticesBuffer[idxC];
    
    float3 worldA = mul(LocalToWorldMatrix, float4(localA, 1.0)).xyz;
    float3 worldB = mul(LocalToWorldMatrix, float4(localB, 1.0)).xyz;
    float3 worldC = mul(LocalToWorldMatrix, float4(localC, 1.0)).xyz;

    float3 triMin = min(worldA, min(worldB, worldC));
    float3 triMax = max(worldA, max(worldB, worldC));

    int3 minCell = max(int3(0,0,0), int3((triMin - GridBoundsMin) / GridCellSize));
    int3 maxCell = min(GridResolution - int3(1,1,1), int3((triMax - GridBoundsMin) / GridCellSize));

    for (int z = minCell.z; z <= maxCell.z; z++)
    {
        for (int y = minCell.y; y <= maxCell.y; y++)
        {
            for (int x = minCell.x; x <= maxCell.x; x++)
            {
                int cellIdx = x + y * GridResolution.x + z * GridResolution.x * GridResolution.y;
                int count;
                InterlockedAdd(GridBuffer[cellIdx * GRID_CELL_STRIDE], 1, count);
                if (count < MAX_TRIS_PER_CELL)
                {
                    GridBuffer[cellIdx * GRID_CELL_STRIDE + 1 + count] = triIdx;
                }
            }
        }
    }
}

// Utility: Closest point on a triangle
float3 ClosestPointOnTriangle(float3 p, float3 a, float3 b, float3 c)
{
    float3 ab = b - a;
    float3 ac = c - a;
    float3 ap = p - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) return a; // barycentric (1,0,0)

    float3 bp = p - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) return b; // barycentric (0,1,0)

    float vc = d1*d4 - d3*d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0)
    {
        float v = d1 / (d1 - d3);
        return a + v * ab;
    }

    float3 cp = p - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) return c; // barycentric (0,0,1)

    float vb = d5*d2 - d1*d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0)
    {
        float w = d2 / (d2 - d6);
        return a + w * ac;
    }

    float va = d3*d6 - d5*d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0)
    {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + w * (c - b);
    }

    float denom = 1.0 / (va + vb + vc);
    float v2 = vb * denom;
    float w2 = vc * denom;
    return a + ab * v2 + ac * w2;
}

// Möller-Trumbore ray-triangle intersection (double-sided).
// Returns 1 if the ray (origin, dir) intersects the triangle at t > epsilon, else 0.
int RayTriangleHit(float3 rayO, float3 rayD, float3 a, float3 b, float3 c)
{
    float3 edge1 = b - a;
    float3 edge2 = c - a;
    float3 h = cross(rayD, edge2);
    float det = dot(edge1, h);
    if (abs(det) < 1e-7) return 0;         // Ray parallel to triangle
    float invDet = 1.0 / det;
    float3 s = rayO - a;
    float u = invDet * dot(s, h);
    if (u < 0.0 || u > 1.0) return 0;
    float3 q = cross(s, edge1);
    float v = invDet * dot(rayD, q);
    if (v < 0.0 || u + v > 1.0) return 0;
    float t = invDet * dot(edge2, q);
    return (t > 1e-5) ? 1 : 0;             // t > 0: forward intersection
}

// Möller-Trumbore ray-triangle intersection returning hit distance t.
bool RayTriangleHitDist(float3 rayO, float3 rayD, float3 a, float3 b, float3 c, out float tHit)
{
    tHit = -1.0;
    float3 edge1 = b - a;
    float3 edge2 = c - a;
    float3 h = cross(rayD, edge2);
    float det = dot(edge1, h);
    if (abs(det) < 1e-7) return false;
    float invDet = 1.0 / det;
    float3 s = rayO - a;
    float u = invDet * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;
    float3 q = cross(s, edge1);
    float v = invDet * dot(rayD, q);
    if (v < 0.0 || u + v > 1.0) return false;
    float t = invDet * dot(edge2, q);
    if (t > 1e-5)
    {
        tHit = t;
        return true;
    }
    return false;
}

[numthreads(256, 1, 1)]
void CheckCollisionTransform (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PointsCount) return;

    float3 p = PointCloudBuffer[id.x].position;
    PointCollisionData res;
    res.isColliding = 0;
    res.distance = 0.0;
    res.pointPos = p;
    res.hitPoint = float3(0, 0, 0);
    res.hitNormal = float3(0, 0, 0);

    if (DistanceMode == 1) // ViewDirection
    {
        float3 camPos = CameraPosition;
        float3 rayToTarget = TargetPosition - camPos;
        float targetDist = length(rayToTarget);
        float3 rayD = (targetDist > 0.0001) ? (rayToTarget / targetDist) : float3(0, 0, 1);

        float3 rayToP = p - camPos;
        float distP = length(rayToP);
        float projDist = dot(rayToP, rayD);
        float lateralDist = length(rayToP - rayD * projDist);

        if (lateralDist <= SurfaceDistanceThreshold)
        {
            float depthDiff = distP - targetDist;
            if (depthDiff <= 0.0 && -depthDiff <= SurfaceDistanceThreshold)
            {
                res.isColliding = 1;
                res.distance = abs(depthDiff);
                res.hitPoint = TargetPosition;
                res.hitNormal = (distP > 0.001) ? normalize(rayToP) : float3(0, 1, 0);
            }
            else if (depthDiff > 0.0 && depthDiff <= BackfaceDistanceThreshold)
            {
                res.isColliding = 2;
                res.distance = abs(depthDiff);
                res.hitPoint = TargetPosition;
                res.hitNormal = (distP > 0.001) ? normalize(rayToP) : float3(0, 1, 0);
            }
        }
    }
    else // MeshSurface (TransformOnly)
    {
        if (TargetPositionsCount > 0)
        {
            float minGlobalDist = 999999.0;
            int bestIdx = -1;
            float3 bestDiff = float3(0, 0, 0);

            for (uint tIdx = 0; tIdx < TargetPositionsCount; tIdx++)
            {
                float3 targetPos = TargetPositionsBuffer[tIdx];
                float3 diff = p - targetPos;
                float dist = length(diff);
                if (dist < minGlobalDist)
                {
                    minGlobalDist = dist;
                    bestIdx = (int)tIdx;
                    bestDiff = diff;
                }
            }

            if (bestIdx >= 0 && minGlobalDist <= SurfaceDistanceThreshold)
            {
                res.isColliding = 1;
                res.distance = minGlobalDist;
                res.hitPoint = TargetPositionsBuffer[bestIdx];
                res.hitNormal = (minGlobalDist > 0.001) ? normalize(bestDiff) : float3(0, 1, 0);
            }
        }
        else
        {
            float3 diff = p - TargetPosition;
            float dist = length(diff);

            if (dist <= SurfaceDistanceThreshold)
            {
                res.isColliding = 1;
                res.distance = dist;
                res.hitPoint = TargetPosition;
                res.hitNormal = (dist > 0.001) ? normalize(diff) : float3(0,1,0);
            }
        }
    }
    
    ResultBuffer[id.x] = res;
}

[numthreads(64, 1, 1)]
void CheckCollisionMesh (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PointsCount) return;

    float3 p = PointCloudBuffer[id.x].position;
    PointCollisionData res;
    res.isColliding = 0;
    res.distance = 0.0;
    res.pointPos = p;
    res.hitPoint = float3(0, 0, 0);
    res.hitNormal = float3(0, 0, 0);

    // Broad-phase AABB check
    if (p.x < MeshBoundsMin.x || p.y < MeshBoundsMin.y || p.z < MeshBoundsMin.z ||
        p.x > MeshBoundsMax.x || p.y > MeshBoundsMax.y || p.z > MeshBoundsMax.z)
    {
        ResultBuffer[id.x] = res;
        return;
    }

    float minDistSqr = 9999999.0;
    float3 bestClosestP = float3(0,0,0);
    float3 bestNormal = float3(0,0,0);
    float bestSignedDist = 9999999.0;

    // Determine grid search threshold
    float maxThresh = SurfaceDistanceThreshold;
    if (DistanceMode == 1)
    {
        maxThresh = max(max(VisibleSurfaceDistanceThreshold, VisibleBackfaceDistanceThreshold),
                        max(OccludedSurfaceDistanceThreshold, OccludedBackfaceDistanceThreshold));
    }
    else
    {
        maxThresh = max(SurfaceDistanceThreshold, BackfaceDistanceThreshold);
    }

    float3 pMin = p - float3(maxThresh, maxThresh, maxThresh);
    float3 pMax = p + float3(maxThresh, maxThresh, maxThresh);

    int3 minCell = max(int3(0,0,0), int3((pMin - GridBoundsMin) / GridCellSize));
    int3 maxCell = min(GridResolution - int3(1,1,1), int3((pMax - GridBoundsMin) / GridCellSize));

    for (int z = minCell.z; z <= maxCell.z; z++)
    {
        for (int y = minCell.y; y <= maxCell.y; y++)
        {
            for (int x = minCell.x; x <= maxCell.x; x++)
            {
                int cellIdx = x + y * GridResolution.x + z * GridResolution.x * GridResolution.y;
                int count = min(MAX_TRIS_PER_CELL, GridBuffer[cellIdx * GRID_CELL_STRIDE]);
                
                for (int i = 0; i < count; i++)
                {
                    uint triIdx = GridBuffer[cellIdx * GRID_CELL_STRIDE + 1 + i];
                    
                    int idxA = MeshIndicesBuffer[triIdx*3];
                    int idxB = MeshIndicesBuffer[triIdx*3+1];
                    int idxC = MeshIndicesBuffer[triIdx*3+2];
                    
                    float3 localA = MeshVerticesBuffer[idxA];
                    float3 localB = MeshVerticesBuffer[idxB];
                    float3 localC = MeshVerticesBuffer[idxC];
                    
                    float3 worldA = mul(LocalToWorldMatrix, float4(localA, 1.0)).xyz;
                    float3 worldB = mul(LocalToWorldMatrix, float4(localB, 1.0)).xyz;
                    float3 worldC = mul(LocalToWorldMatrix, float4(localC, 1.0)).xyz;
                    
                    float3 closestP = ClosestPointOnTriangle(p, worldA, worldB, worldC);
                    float3 diff = p - closestP;
                    float dSqr = dot(diff, diff);
                    
                    if (dSqr < minDistSqr)
                    {
                        minDistSqr = dSqr;
                        bestClosestP = closestP;
                        
                        float3 worldN = normalize(cross(worldB - worldA, worldC - worldA));
                        bestNormal = worldN;
                        
                        float planeDist = dot(p - worldA, worldN);
                        bestSignedDist = (planeDist < 0.0) ? -sqrt(dSqr) : sqrt(dSqr);
                    }
                }
            }
        }
    }

    // Active threshold selection according to DistanceMode
    float activeSurfaceThresh = SurfaceDistanceThreshold;
    float activeBackfaceThresh = BackfaceDistanceThreshold;

    if (DistanceMode == 1) // ViewDirection Mode (Normal & View Vector Dot Product)
    {
        float3 dirToCam = CameraPosition - bestClosestP;
        float distToCam = length(dirToCam);
        if (distToCam > 0.0001) dirToCam /= distToCam;
        else dirToCam = float3(0, 0, 1);

        // Positive dot product means the mesh surface normal faces towards the camera (Visible/Front-facing)
        float dotProd = dot(bestNormal, dirToCam);

        if (dotProd > 0.0)
        {
            activeSurfaceThresh = VisibleSurfaceDistanceThreshold;
            activeBackfaceThresh = VisibleBackfaceDistanceThreshold;
        }
        else
        {
            activeSurfaceThresh = OccludedSurfaceDistanceThreshold;
            activeBackfaceThresh = OccludedBackfaceDistanceThreshold;
        }
    }

    float calculatedDist = (minDistSqr < 9999999.0) ? sqrt(minDistSqr) : 0.0;

    if (minDistSqr < 9999999.0)
    {
        // 表側接触: 法線に対して外側/手前（bestSignedDist >= 0）かつ surfaceDistance 閾値以内
        if (bestSignedDist >= 0.0 && calculatedDist <= activeSurfaceThresh)
        {
            res.isColliding = 1;
            res.distance   = calculatedDist;
            res.hitPoint   = bestClosestP;
            res.hitNormal  = bestNormal;
        }
        // 裏側・めり込み接触: 法線に対して内側/めり込み（bestSignedDist < 0）かつ backfaceDistance 閾値以内
        else if (bestSignedDist < 0.0 && calculatedDist <= activeBackfaceThresh)
        {
            res.isColliding = 2;
            res.distance   = calculatedDist;
            res.hitPoint   = bestClosestP;
            res.hitNormal  = bestNormal;
        }
    }

    ResultBuffer[id.x] = res;
}

[numthreads(256, 1, 1)]
void CheckCollisionFootPlane (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PointsCount) return;

    float3 p = PointCloudBuffer[id.x].position;
    PointCollisionData res;
    res.isColliding = 0;
    res.distance = 0.0;
    res.pointPos = p;
    res.hitPoint = float3(0, 0, 0);
    res.hitNormal = float3(0, 0, 0);

    // ワールド座標からターゲットローカル座標へ変換
    float4 localP4 = mul(WorldToTargetMatrix, float4(p, 1.0));
    float3 localP = localP4.xyz;

    // 水平領域判定 (ローカルXZの拡大矩形内)
    if (localP.x >= FootPlaneBoundsMin.x && localP.x <= FootPlaneBoundsMax.x &&
        localP.z >= FootPlaneBoundsMin.z && localP.z <= FootPlaneBoundsMax.z)
    {
        // 平面からの相対高さ (ローカルY)
        float h = localP.y - FootPlaneRefY;

        // 平面より下部かつ深さ閾値以内 (-depthThreshold <= h <= upperMargin)
        if (h >= -FootPlaneDepthThreshold && h <= FootPlaneUpperMargin)
        {
            res.isColliding = 1;
            res.distance = abs(h);
            res.hitPoint = p - FootPlaneNormal * h;
            res.hitNormal = FootPlaneNormal;
        }
    }

    ResultBuffer[id.x] = res;
}

